# ----------------------------------------------------
# Public Application Load Balancer (ALB)
# Spans 2 Public Subnets in different Availability Zones
# ----------------------------------------------------
resource "aws_lb" "main" {
  name               = "${var.environment}-dsa-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = aws_subnet.public[*].id

  enable_deletion_protection = false
  idle_timeout               = 300 # 5 minutes for AI generation and LLM streams

  tags = {
    Name = "${var.environment}-dsa-alb"
  }
}

# ----------------------------------------------------
# Target Group 1: Next.js Frontend (Port 3000)
# ----------------------------------------------------
resource "aws_lb_target_group" "frontend" {
  name        = "${var.environment}-frontend-tg"
  port        = 3000
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "instance"

  health_check {
    enabled             = true
    path                = "/"
    port                = "3000"
    protocol            = "HTTP"
    healthy_threshold   = 3
    unhealthy_threshold = 3
    timeout             = 5
    interval            = 30
    matcher             = "200-399"
  }

  tags = {
    Name = "${var.environment}-frontend-tg"
  }
}

# ----------------------------------------------------
# Target Group 2: FastAPI Backend API (Port 8000)
# ----------------------------------------------------
resource "aws_lb_target_group" "backend" {
  name        = "${var.environment}-backend-tg"
  port        = 8000
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "instance"

  health_check {
    enabled             = true
    path                = "/api/v1/health"
    port                = "8000"
    protocol            = "HTTP"
    healthy_threshold   = 3
    unhealthy_threshold = 3
    timeout             = 5
    interval            = 15
    matcher             = "200"
  }

  tags = {
    Name = "${var.environment}-backend-tg"
  }
}

# ----------------------------------------------------
# Default Listener: Port 80 (HTTP) -> Frontend
# ----------------------------------------------------
resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.frontend.arn
  }
}

# ----------------------------------------------------
# Path-Based Routing Rule: /api/* -> FastAPI Backend Target Group
# ----------------------------------------------------
resource "aws_lb_listener_rule" "api_routing" {
  listener_arn = aws_lb_listener.http.arn
  priority     = 10

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.backend.arn
  }

  condition {
    path_pattern {
      values = ["/api/*", "/docs", "/openapi.json"]
    }
  }
}
